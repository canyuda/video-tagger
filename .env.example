# Template for .env.local (git-ignored). Copy and fill in real values.
# Read order for Phase 0 CLI: process env vars > .env.local.
# Rule: keys never go into docs/, logs, or git commits.

# Required: Alibaba Model Studio (Bailian) — perception VLM (qwen3-vl-flash), ASR (paraformer-v2), optional embedding L0
DASHSCOPE_API_KEY=

# Required: TypeSafe (Jev decision layer)
TYPESAFE_API_KEY=

# Optional: Zhipu bigmodel — GLM-4.6V-Flash free tier (perception baseline / fallback VLM)
ZHIPU_API_KEY=

# Optional: Volcengine Ark — backup ASR (Seed-ASR 2.0) and backup VLM (doubao-seed-1.6-vision)
ARK_API_KEY=

# Optional: Aliyun OSS — stable public URL input for paraformer-v2.
# Disabled by default in V1 (D46): Bailian temp storage suffices; current AK/SK points to a
# team test bucket — do not enable for personal use. Replace with a personal bucket if needed.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_BUCKET_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Phase 2: Douyin web cookie (full cookie string; contains login session — keep local)
DOUYIN_COOKIE=
