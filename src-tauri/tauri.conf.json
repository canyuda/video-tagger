{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "video-tagger",
  "version": "0.1.0",
  "identifier": "com.yiqi.videotagger",
  "build": {
    "beforeDevCommand": "bash scripts/prepare_sidecar.sh dev && npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bash scripts/prepare_sidecar.sh release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "视频分类 · video-tagger",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/video-tagger-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
